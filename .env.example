# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
# Format for asyncpg: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/railway

# Shared Internal Key for Next.js BFF -> FastAPI Auth
INTERNAL_API_KEY=change_this_to_a_secure_shared_secret_32_chars_min

# Security & Sessions
COOKIE_NAME=access_token
COOKIE_DURATION_DAYS=30

# API Docs Basic Auth credentials (comma-separated username:password pairs)
DOCS_USERS=admin:mannabooks2026,team:stagingpass2026

# KRA eTIMS Gateway (OSCU Integration)
KRA_ETIMS_ENV=SANDBOX
KRA_ETIMS_BASE_URL=https://timsvscu.kra.go.ke/etims-api
KRA_ETIMS_AES_ENCRYPTION_KEY=replace_with_32_byte_aes_master_key


cd mannabooksapi
python -m venv .venv
.venv\Scripts\activate
pip install -r requirements.txt
cp .env.example .env
uvicorn app.main:app --reload --port 8000


API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=manna_books_internal_secret_key_default
API_MODULES=auth,workspaces,etims
