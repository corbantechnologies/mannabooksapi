# ==============================================================================
# MannaBooks FastAPI backend – example configuration.
# Copy to .env and fill in. NEVER put real secrets in this file.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
PORT=8000
LOG_LEVEL=INFO
TZ=Africa/Nairobi

# --- Database ------------------------------------------------------------------
# Local: `docker compose up -d db`. Development refuses remote hosts unless
# ALLOW_REMOTE_DB_IN_DEVELOPMENT=true is set deliberately.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mannabooks
ALLOW_REMOTE_DB_IN_DEVELOPMENT=false
# Only for throwaway local databases. Deployed DBs use `python -m alembic upgrade head`.
AUTO_INIT_DB=false

# --- Service-to-service auth (must match the Next.js app) ------------------------
INTERNAL_API_KEY=<min-32-random-chars>
CRON_SECRET=<min-24-random-chars>

# --- Sessions ------------------------------------------------------------------
COOKIE_NAME=access_token
JWT_SECRET=<min-32-random-chars>
JWT_ALGORITHM=HS256
# 15-minute access tokens, renewed silently with rotating refresh tokens.
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_IDLE_HOURS=12
REFRESH_REUSE_GRACE_SECONDS=60

# --- Redis (rate limiting) ----------------------------------------------------
# Railway: reference the Redis service variable, e.g. REDIS_URL=${{Redis.REDIS_URL}}
# Empty = per-process in-memory limits (fine for local development).
REDIS_URL=

# --- HTTP ----------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# API docs (/docs). Empty = disabled. Never served in production unless ENABLE_API_DOCS=true.
DOCS_USERS=
ENABLE_API_DOCS=false

# --- KRA eTIMS (OSCU) ------------------------------------------------------------
ENABLE_KRA_ETIMS_GLOBAL=false
KRA_ETIMS_MOCK_MODE=false
KRA_ETIMS_ENV=SANDBOX
KRA_ETIMS_BASE_URL=https://timsvscu.kra.go.ke/etims-api
# Exactly 32 characters (AES-256 master key for tenant device secrets)
KRA_ETIMS_AES_ENCRYPTION_KEY=<32-char-key>
